@using Crittery.Me.Data.Enums
@using Crittery.Me.Data.Models
@using Crittery.Me.Data.Models.Images

@model IEnumerable<Link>?

<div id="dashboard-links" class="card">
    <div class="card-body">
        <div class="card-title d-flex justify-content-between gap-2">
            <h2 class="h5 m-0">Links</h2>
            <a asp-page="/Link/Index" class="btn btn-outline-info">View All</a>
        </div>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th aria-label="Order">#</th>
                    <th>Icon</th>
                    <th>Link</th>
                    <th>Visible</th>
                    <th aria-hidden="true"></th>
                </tr>
            </thead>    
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (Link link in Model)
                    {
                        ImageFile? filePng = link.Icon.Files
                            .FirstOrDefault(file => file.MediaType.EndsWith("png", StringComparison.OrdinalIgnoreCase));
                        ImageFile? fileWebp = link.Icon.Files
                            .FirstOrDefault(file => file.MediaType.EndsWith("webp", StringComparison.OrdinalIgnoreCase));

                        <tr class="align-middle">
                            <td>@link.Order</td>
                            <td>
                                @if (filePng != null)
                                {
                                    <picture>
                                        @if (fileWebp != null)
                                        {
                                            <source srcset="@fileWebp.Source" type="image/webp" />
                                        }
                                        <source srcset="@filePng.Source" type="image/png" />
                                        <img src="@filePng.Source" width="24" height="24" alt="Image preview" />
                                    </picture>
                                }
                            </td>
                            <td>
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer" title="@link.Title">@link.Text</a>
                            </td>
                            @if (link.Visiblity == LinkVisiblity.OnAllDays)
                            {
                                <td>Always</td>
                            }
                            else if (link.Visiblity == LinkVisiblity.OnEventDay)
                            {
                                <td>Event Days</td>
                            }
                            else if (link.Visiblity == LinkVisiblity.OnOtherDays)
                            {
                                <td>Non-event Days</td>
                            }
                            else
                            {
                                <td>Never</td>
                            }
                            <td class="text-end">
                                <a asp-page="/Bio/Edit" asp-route-id="@link.Id" class="btn btn-primary">Edit</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="fst-italic text-center text-secondary">No links</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>