@{
    string page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &mdash; CMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/_content/Crittery.Me.Editor/css/cms.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            <a asp-area="" asp-page="/Index" asp-route-from="CMS" target="_blank" class="navbar-brand">crittery.me</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a asp-page="/Index" class="nav-link @(page.Equals("/Index") ? "active" : string.Empty)" aria-current="@(page.Equals("/Index") ? "page" : null)">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a asp-page="/Visitor/Index" class="nav-link @(page.StartsWith("/Visitor") ? "active" : string.Empty)" aria-current="@(page.StartsWith("/Visitor") ? "page" : null)">Visitors</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a asp-page="/Calendar/Index" class="nav-link @(page.StartsWith("/Calendar") ? "active" : string.Empty) dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Calendar
                        </a>
                        <ul class="dropdown-menu">
                            <li><a asp-page="/Calendar/Index" class="dropdown-item @(page.Equals("/Calendar/Index") ? "active" : string.Empty)" aria-current="@(page.Equals("/Calendar/Index") ? "page" : null)">View</a></li>
                            <li><a asp-page="/Calendar/New" class="dropdown-item @(page.Equals("/Calendar/New") ? "active" : string.Empty)" aria-current="@(page.Equals("/Calendar/New") ? "page" : null)">+ Add New</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a asp-page="/Photo/Index" class="nav-link @(page.StartsWith("/Photo") ? "active" : string.Empty) dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Photos
                        </a>
                        <ul class="dropdown-menu">
                            <li><a asp-page="/Photo/Index" class="dropdown-item @(page.Equals("/Photo/Index") ? "active" : string.Empty)" aria-current="@(page.Equals("/Photo/Index") ? "page" : null)">View</a></li>
                            <li><a asp-page="/Photo/New" class="dropdown-item @(page.Equals("/Photo/New") ? "active" : string.Empty)" aria-current="@(page.Equals("/Photo/New") ? "page" : null)">+ Add New</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a asp-page="/Link/Index" class="nav-link @(page.StartsWith("/Link") ? "active" : string.Empty) dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Links
                        </a>
                        <ul class="dropdown-menu">
                            <li><a asp-page="/Link/Index" class="dropdown-item @(page.Equals("/Link/Index") ? "active" : string.Empty)" aria-current="@(page.Equals("/Link/Index") ? "page" : null)">View</a></li>
                            <li><a asp-page="/Link/New" class="dropdown-item @(page.Equals("/Link/New") ? "active" : string.Empty)" aria-current="@(page.Equals("/Link/New") ? "page" : null)">+ Add New</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle @(page.StartsWith("/Bio") || page.StartsWith("/Interests") || page.StartsWith("/Relationship") ? "active" : string.Empty)" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Content
                        </a>
                        <ul class="dropdown-menu">
                            <li><a asp-page="/Bio/Index" class="dropdown-item @(page.Equals("/Bio/Index") ? "active" : string.Empty)" aria-current="@(page.Equals("/Bio/Index") ? "page" : null)">Bio</a></li>
                            <li><a asp-page="/Bio/New" class="dropdown-item @(page.Equals("/Bio/New") ? "active" : string.Empty)" aria-current="@(page.Equals("/Bio/New") ? "page" : null)">+ Add New</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a asp-page="/Interests/Index" class="dropdown-item @(page.Equals("/Interests/Index") ? "active" : string.Empty)" aria-current="@(page.Equals("/Interests/Index") ? "page" : null)">Interests</a></li>
                            <li><a asp-page="/Interests/New" class="dropdown-item @(page.Equals("/Interests/New") ? "active" : string.Empty)" aria-current="@(page.Equals("/Interests/New") ? "page" : null)">+ Add New</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a asp-page="/Relationship/Index" class="dropdown-item @(page.Equals("/Relationship/Index") ? "active" : string.Empty)" aria-current="@(page.Equals("/Relationship/Index") ? "page" : null)">Relationship</a></li>
                            <li><a asp-page="/Relationship/New" class="dropdown-item @(page.Equals("/Relationship/New") ? "active" : string.Empty)" aria-current="@(page.Equals("/Relationship/New") ? "page" : null)">+ Add New</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container my-3">
        <main>
            @if (IsSectionDefined("Header"))
            {
                <header>
                    @await RenderSectionAsync("Header", required: false)
                </header>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/Crittery.Me.Editor/js/cms.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>