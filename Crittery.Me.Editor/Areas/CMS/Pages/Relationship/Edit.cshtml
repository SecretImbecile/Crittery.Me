@page "{id:guid}"

@model Crittery.Me.Editor.Areas.CMS.Pages.Relationship.EditModel

@{
    ViewData["Title"] = $"Edit Relationship Item";
}

@section Header
{
    <h1 class="h2 my-3">Edit Bio Item</h1>
}

<form method="post" asp-route-id="@Model.FormData.Id">
    <div class="mb-3">
        <label asp-for="FormData.Text" class="form-label">Text</label>
        <input asp-for="FormData.Text" class="form-control" placeholder="It's complicated" maxlength="160" />
    </div>
    <button type="submit" class="btn btn-lg btn-primary mb-3">Save</button>
</form>