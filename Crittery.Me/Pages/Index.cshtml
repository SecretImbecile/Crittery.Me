@page

@using Crittery.Me.Data.Models

@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

@if (Model.NextConvention != null)
{
    <p>@Model.NextConvention.DateStart.ToString("dd MMM") 🔜 @Model.NextConvention?.Name</p>
}
@if (Model.NextMeet != null)
{
    <p>@Model.NextMeet.DateStart.ToString("dd MMM") 🔜 @Model.NextMeet?.Name</p>
}

<h2 class="h3">About Me</h2>
<ul>
    @foreach(BioItem item in Model.BioItems)
    {
        <li>@item.Text</li>
    }
</ul>