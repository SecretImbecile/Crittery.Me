@page

@using Crittery.Me.Data.Models

@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

@foreach(CalendarEvent calendarEvent in Model.CalendarEvents)
{
    <p><partial name="Partials/_CalendarEvent" model="calendarEvent" /></p>
}

<h2 class="h3">About Me</h2>
<ul>
    @foreach(BioItem item in Model.BioItems)
    {
        <li>@item.Text</li>
    }
</ul>