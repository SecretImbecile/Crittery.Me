@page

@using Crittery.Me.Data.Models

@model IndexModel

@{
    ViewData["Title"] = "Linden ⭒ Jittery Critter";
}

@section Header {
    <picture id="logo">
        <source srcset="img/logo-v2.webp" type="image/webp">
        <source srcset="img/logo-v2.webp" type="image/png">
        <img src="img/logo-v2.webp" width="900" height="450" alt="Linden (he/they)">
    </picture>
}

@if (Model.ContentBio.Count > 0)
{
    <p class="bio">
        @foreach (BioContent item in Model.ContentBio)
        {
            <span>@item.Text</span>
        }
    </p>
}

@if (Model.Links.Count > 0)
{
    <nav aria-label="Links" class="mb-3">
        @foreach(Link link in Model.Links)
        {
            @if (Model.IsExtraContentEnabled || link.Visiblity.HasFlag(Data.Enums.LinkVisiblity.OnOtherDays))
            {
                <a class="button" href="@link.Url" title="@link.Title">
                    <img src="@link.Icon.Files.FirstOrDefault()?.Source" width="28" height="28" alt="">
                    <span>@link.Text</span>
                </a>
            }
        }
    </nav>
}

@if (Model.ContentCalendar.Count > 0)
{
    <div class="mb-3">
        <p class="fw-bold text-center mb-0">Attending:</p>
        @foreach(CalendarEvent calendarEvent in Model.ContentCalendar)
        {
            <p class="text-center mb-0"><partial name="Partials/_CalendarEvent" model="calendarEvent" /></p>
        }
    </div>
}

@if (Model.IsExtraContentEnabled)
{
    if (Model.ContentInterests.Count > 0)
    {
        <div class="mb-3">
            <p class="fw-bold text-center mb-0">Interests include:</p>
            <p class="bio">
                @foreach(InterestContent content in Model.ContentInterests)
                {
                    <span><i class="icon" aria-hidden="true">@content.Emoji</i> @content.Text</span>
                }
            </p>
        </div>
    }

    if (Model.ContentRelationships.Count > 0)
    {
        <p class="bio mb-0">
            @foreach(RelationshipContent content in Model.ContentRelationships)
            {
                if (content.Text.Contains("🏳️‍🌈"))
                {
                    <span aria-label="Gay">@content.Text</span>
                }
                else
                {
                    <span>@content.Text</span>
                }
            }
        </p>
    }
}