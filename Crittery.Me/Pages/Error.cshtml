@page
@model ErrorModel
@{
    ViewData["Title"] = "Whoops ⭒ Crittery Me";
}

@section Header {
    <picture id="logo">
        <source srcset="img/logo-v2.webp" type="image/webp">
        <source srcset="img/logo-v2.webp" type="image/png">
        <img src="img/logo-v2.webp" width="900" height="450" alt="Linden (he/they)">
    </picture>
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}