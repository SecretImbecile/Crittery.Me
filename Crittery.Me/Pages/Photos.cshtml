@page "/Photos/{stub?}"

@using Crittery.Me.Classes
@using Crittery.Me.Data.Models

@model Crittery.Me.Pages.PhotosModel

@{
    string description = "Fursuit photographs by Linden";

    if (Model.PhotoCurrent != null)
    {
        ViewData["Title"] = $"{Model.PhotoCurrent.Title} ⭒ Crittery Me";
        if (!string.IsNullOrWhiteSpace(Model.PhotoCurrent.Metadata.ImageDescription))
        {
            description = Model.PhotoCurrent.Metadata.ImageDescription;
        }
    }
    else
    {
        ViewData["Title"] = "Photos ⭒ Crittery Me";
    }
}

@section OpenGraph {
    @if (Model.PhotoCurrent != null)
    {
        <meta name="description" content="@description">
        <meta property="og:title" content="@ViewData["Title"]">
        <meta property="og:description" content="@description">
        <meta property="og:url" content="@Url.PhotoPage(Model.PhotoCurrent)" />
        <meta property="og:image" content="@Url.PhotoThumbnail(Model.PhotoCurrent)" />
        <meta property="og:type" content="article" />
        <meta property="article:published_time" content="@Model.PhotoCurrent.CapturedOn" />
        <meta property="article:author" content="crittery.me" />
    }
    else
    {
        <meta name="description" content="@description">
        <meta property="og:title" content="@ViewData["Title"]">
        <meta property="og:description" content="@description">
        <meta property="og:url" content="https://crittery.me/Photos" />
        <meta property="og:image" content="https://crittery.me/img/cover.jpg" />
        <meta property="og:type" content="website" />
    }
}

@section Head {
    <link rel="stylesheet" href="@Url.Content("~/css/photos.css")" asp-append-version="true" />
}

@section Header {
    <picture id="logo">
        <source srcset="/img/logo-photo-v2.png" type="image/webp">
        <source srcset="/img/logo-photo-v2.webp" type="image/png">
        <img src="/img/logo-photo-v2.png" width="1024" height="256" alt="crittery.me">
    </picture>
}

@section Figures {
    @if (Model.PhotoCurrent != null)
    {
        <figure id="photo-full">
            <partial name="Partials/_Photo" model="Model" />
        </figure>
    }
    else
    {
        <figure id="photo-full" class="d-none">
        </figure>
    }
}

<p>
    I take photgraphs at local furmeets and publish them under the <em>crittery.me</em> branding.
    All of my fursuit photography can be found in full-resoluton on FurTrack:
</p>

<nav aria-label="Links" class="links mb-3">
    <a class="btn" href="https://www.furtrack.com/index/photographer:crittery_me" target="_blank" rel="noopener" title="Photographer tag on FurTrack">
        <img src="/img/icons/furtrack.png" width="28" height="28" alt="">
        <span>All Photographs</span>
    </a>
</nav>

@if (Model.Photos.Count > 0)
{
    <div id="photos" class="photos" aria-label="Photo Highlights">
        @foreach (Photo photo in Model.Photos)
        {
            <a asp-page="/Photos" asp-route-stub="@photo.Stub" id="@photo.Stub" data-photo="@photo.Stub" title="@photo.Title">
                <picture>
                    <source srcset="@photo.ImageThumbnail.Files[1].Source" type="image/webp">
                    <source srcset="@photo.ImageThumbnail.Files[0].Source" type="image/jpg">
                    <img src="@photo.ImageThumbnail.Files[0].Source" loading="lazy" width="512" height="512" alt="@photo.Title">
                </picture>
            </a>
        }
    </div>
}

<p>
    My furmeet photos are released under the
    <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" target="_blank">CC BY-NC-ND</a>
    licence.
</p>
<p class="fineprint">
    This means you are free to repost my photos without asking me, so long as you leave them unedited and attribute them to me.
    Leaving the watermark uncropped is sufficient attribution, but tagging me on any social platform I'm on is also appreciated.
</p>
<p>
    If you wish to license a photo for commercial use, or would like an unwatermarked version for personal printing, please email me:
</p>

<nav aria-label="Email Me" class="links mb-3">
    <a class="btn" href="mailto:photos@crittery.me?subject=Photo Request" title="Email photos@crittery.me">
