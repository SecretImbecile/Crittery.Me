@page

@model Crittery.Me.Pages.PhotosModel

@{
    ViewData["Title"] = "Photos ⭒ Crittery Me";
}

@section Header {
    <picture id="logo">
        <source srcset="img/logo-photo-v2.png" type="image/webp">
        <source srcset="img/logo-photo-v2.webp" type="image/png">
        <img src="img/logo-photo-v2.png" width="1024" height="256" alt="crittery.me">
    </picture>
}

<nav aria-label="Links" class="mb-3">
    <a class="button" href="https://www.furtrack.com/index/photographer:crittery_me" title="crittery_me on Furtrack">
        <img src="img/icons/furtrack.png" width="28" height="28" alt="">
        <span>FurTrack</span>
    </a>
</nav>

<div class="photos">
    <a href="img/photos/_MG_8758.jpg"
        data-webp="img/photos/_MG_8758.webp"
        data-caption="Minty, a cheetah fursuiter, poking his head out the side of Hideout Tiki Bar in Warrington"
        data-furtrack="https://www.furtrack.com/p/1557791">
        <picture>
            <source srcset="img/photos/_MG_8758_thumb.webp" type="image/webp">
            <source srcset="img/photos/_MG_8758_thumb.jpg" type="image/jpg">
            <img src="img/photos/_MG_8758_thumb.jpg" width="512" height="512" alt="Minty in the Hideout Doorway">
        </picture>
    </a>
    <a href="img/photos/_MG_8987.jpg" data-webp="img/photos/_MG_8987.webp">
        <picture>
            <source srcset="img/photos/_MG_8987_thumb.webp" type="image/webp">
            <source srcset="img/photos/_MG_8987_thumb.jpg" type="image/jpg">
            <img src="img/photos/_MG_8987_thumb.jpg" width="512" height="512" alt="Tangoh on the Park Bench">
        </picture>
    </a>
    <a href="img/photos/_MG_9015.jpg" data-webp="img/photos/_MG_9015.webp">
        <picture>
            <source srcset="img/photos/_MG_9015_thumb.webp" type="image/webp">
            <source srcset="img/photos/_MG_9015_thumb.jpg" type="image/jpg">
            <img src="img/photos/_MG_9015_thumb.jpg" width="512" height="512" alt="Cami on Canal Street">
        </picture>
    </a>
    <a href="img/photos/_MG_9702.jpg" data-webp="img/photos/_MG_9702.webp">
        <picture>
            <source srcset="img/photos/_MG_9702_thumb.webp" type="image/webp">
